# ─── Veritabanı ──────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app
DB_NAME=amazon_scoring

# ─── Backend API ─────────────────────────────────────────────────────────────
PORT=8186
# API auth — admin_panel/.env.local içindeki NEXT_PUBLIC_API_SECRET ve
# BACKEND_API_SECRET ile AYNI değer olmalı.
API_SECRET=amozon_secret_change_me

# ─── Veri Kaynakları ─────────────────────────────────────────────────────────
# Oxylabs Web Scraper API (Amazon search + product) — abonelik müşteri hesabında olmalı
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Keepa fiyat geçmişi API
KEEPA_API_KEY=
KEEPA_DAILY_TOKEN_BUDGET=1000

# LLM reasoning (en az biri gerekli — Groq tercih edilir)
GROQ_API_KEY=
OPENAI_API_KEY=

# Opsiyonel ayrı scraper servisi (kullanılmıyorsa boş bırakılabilir)
SCRAPER_SERVICE_URL=http://localhost:8200
SCRAPER_SERVICE_API_KEY=
SCRAPER_CALLBACK_SECRET=

# ─── Seller Enrichment (Phase 4.6 OH.1 — opsiyonel, varsayılanlar üretime uygun) ──
SELLER_BATCH_SIZE=25            # scheduler turunda job başına işlenecek SKU
SELLER_POST_SCAN_BATCH=25       # scan biter bitmez işlenecek SKU
SELLER_TARGET_COVERAGE=0.5      # bu coverage'a ulaşan job artık enrich edilmez
SELLER_MAX_RETRIES=1            # geçici Oxylabs hatasında yeniden deneme

# ─── Thesis & Cache (Phase 4.6/4.7 — opsiyonel) ──────────────────────────────
THESIS_STALE_DAYS=7             # tez kaç gün sonra otomatik yeniden değerlendirilir
SCAN_CACHE_TTL_MIN=360          # aynı keyword için cache reuse penceresi (dakika)
