# ─── Admin Panel (Next.js) ───────────────────────────────────────────────────

# Backend API adresi (sunucu tarafı — Next API route proxy bunu kullanır)
BACKEND_API_URL=http://localhost:8186
# Backend API auth — backend/.env içindeki API_SECRET ile AYNI değer
BACKEND_API_SECRET=amozon_secret_change_me

# Tarayıcı tarafına gömülen API secret — yine API_SECRET ile AYNI
NEXT_PUBLIC_API_SECRET=amozon_secret_change_me

# Panel base path — alt yol altında sunuluyorsa (örn. /amozon), aksi halde boş
NEXT_PUBLIC_BASE_PATH=/amozon
